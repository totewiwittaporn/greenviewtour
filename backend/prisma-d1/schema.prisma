generator client {
  provider = "prisma-client"
  output   = "../src/generated/d1"
  runtime  = "cloudflare"
}
datasource db {
  provider = "sqlite"
}
enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

}
enum AccessScope {
  SELF
  COMPANY

}
model UserProfile {
  firstName String?
  lastName String?
  id String @id
  displayName String
  nickname String?
  department String?
  address String?
  primaryPhone String?
  emergencyPhone String?
  lineId String?
  status AccountStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roles UserRole[]
  accessVersion Int @default(1)
  permissionOverrides UserPermissionOverride[]
  dispatchStaff DispatchStaff[]
  guideAssignments GuideAssignment[]

 province String?
 district String?
 subdistrict String?
 postalCode String?
 houseNumber String?
 moo String?
 villageName String?
 mapUrl String?
 latitude String?
 longitude String?
}
model Role {
  code String @id
  name String
  users UserRole[]
  permissions RolePermission[]
  invitations InvitationRole[]

}
model UserPermissionOverride {
 id String @id @default(uuid())
 userId String
 permissionCode String
 effect String
 scopeId String?
 startsAt DateTime?
 expiresAt DateTime?
 user UserProfile @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId])

}
model Permission {
  code String @id
  description String
  roles RolePermission[]

}
model UserRole {
  userId String
  roleCode String
  scope AccessScope @default(SELF)
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  @@id([userId, roleCode, scope])
  @@index([roleCode])

}
model RolePermission {
  roleCode String
  permissionCode String
  role Role @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)
  @@id([roleCode, permissionCode])
  @@index([permissionCode])

}
model Invitation {
  id String @id @default(uuid())
  email String @unique
  tokenHash String @unique
  displayName String
  department String?
  acceptedAt DateTime?
  revokedAt DateTime?
  createdById String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  consumedAt DateTime?
  roles InvitationRole[]

}
model InvitationRole {
  invitationId String
  roleCode String
  scope AccessScope @default(SELF)
  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  @@id([invitationId, roleCode, scope])
  @@index([roleCode])

}
model AuditEvent {
  id String @id @default(uuid())
  actorId String?
  action String
  targetId String?
  createdAt DateTime @default(now())
  details Json
  @@index([targetId, createdAt])
  @@index([actorId, createdAt])

}

