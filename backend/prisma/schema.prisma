generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  schemas = ["app_private"]
}
enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  @@schema("app_private")
}
enum AccessScope {
  SELF
  COMPANY
  @@schema("app_private")
}
model UserProfile {
  id String @id @db.Uuid
  displayName String @db.VarChar(100)
  department String? @db.VarChar(30)
  address String? @db.VarChar(1000)
  primaryPhone String? @db.VarChar(32)
  emergencyPhone String? @db.VarChar(32)
  lineId String? @db.VarChar(100)
  status AccountStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  roles UserRole[]
  @@schema("app_private")
 province String? @db.VarChar(100)
 district String? @db.VarChar(100)
 subdistrict String? @db.VarChar(100)
 houseNumber String? @db.VarChar(50)
 moo String? @db.VarChar(20)
 villageName String? @db.VarChar(150)
 mapUrl String? @db.VarChar(2048)
 latitude String? @db.VarChar(30)
 longitude String? @db.VarChar(30)
}
model Role {
  code String @id @db.VarChar(50)
  name String @db.VarChar(100)
  users UserRole[]
  permissions RolePermission[]
  invitations InvitationRole[]
  @@schema("app_private")
}
model Permission {
  code String @id @db.VarChar(100)
  description String
  roles RolePermission[]
  @@schema("app_private")
}
model UserRole {
  userId String @db.Uuid
  roleCode String @db.VarChar(50)
  scope AccessScope @default(SELF)
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  @@id([userId, roleCode, scope])
  @@index([roleCode])
  @@schema("app_private")
}
model RolePermission {
  roleCode String @db.VarChar(50)
  permissionCode String @db.VarChar(100)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)
  @@id([roleCode, permissionCode])
  @@index([permissionCode])
  @@schema("app_private")
}
model Invitation {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  tokenHash String @unique @db.Char(64)
  displayName String @db.VarChar(100)
  department String? @db.VarChar(30)
  acceptedAt DateTime? @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdById String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  roles InvitationRole[]
  @@schema("app_private")
}
model InvitationRole {
  invitationId String @db.Uuid
  roleCode String @db.VarChar(50)
  scope AccessScope @default(SELF)
  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  @@id([invitationId, roleCode, scope])
  @@index([roleCode])
  @@schema("app_private")
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  action String @db.VarChar(100)
  targetId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  details Json
  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
  @@schema("app_private")
}

model SalesChannel {
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 code String @db.VarChar(40) @unique
 name String @db.VarChar(200)
 status String @db.VarChar(50)
 kind String @db.VarChar(50)
 @@index([status])
 @@schema("app_private")
}

model CompanySettings {
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 name String @db.VarChar(200)
 legalName String? @db.VarChar(200)
 taxId String? @db.VarChar(30)
 address String? @db.VarChar(1000)
 phone String? @db.VarChar(32)
 email String? @db.VarChar(254)
 @@schema("app_private")
 province String? @db.VarChar(100)
 district String? @db.VarChar(100)
 subdistrict String? @db.VarChar(100)
 houseNumber String? @db.VarChar(50)
 moo String? @db.VarChar(20)
 villageName String? @db.VarChar(150)
 mapUrl String? @db.VarChar(2048)
 latitude String? @db.VarChar(30)
 longitude String? @db.VarChar(30)
}

model BusinessPartner {
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 code String @db.VarChar(40) @unique
 name String @db.VarChar(200)
 status String @db.VarChar(50)
 roles String[]
 contactName String? @db.VarChar(200)
 phone String? @db.VarChar(32)
 email String? @db.VarChar(254)
 address String? @db.VarChar(1000)
 association String? @db.VarChar(200)
 paymentTerms String? @db.VarChar(1000)
 tours TourProgram[]
 agentPrices AgentTourPrice[]
 vehicles FleetVehicle[]
 @@index([status])
 @@schema("app_private")
 province String? @db.VarChar(100)
 district String? @db.VarChar(100)
 subdistrict String? @db.VarChar(100)
 houseNumber String? @db.VarChar(50)
 moo String? @db.VarChar(20)
 villageName String? @db.VarChar(150)
 mapUrl String? @db.VarChar(2048)
 latitude String? @db.VarChar(30)
 longitude String? @db.VarChar(30)
}

model TourProgram {
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 code String @db.VarChar(40) @unique
 name String @db.VarChar(200)
 status String @db.VarChar(50)
 ownership String @db.VarChar(50)
 operatorId String? @db.Uuid
 route String? @db.VarChar(2000)
 departureTimes String? @db.VarChar(300)
 childPolicy String? @db.VarChar(1000)
 confirmationMode String @db.VarChar(50)
 cancellationTerms String? @db.VarChar(2000)
 bookingCutoff String? @db.VarChar(300)
 adultPrice Decimal? @db.Decimal(10,2)
 childPrice Decimal? @db.Decimal(10,2)
 supplierPricing String @db.VarChar(50)
 supplierAdultNet Decimal? @db.Decimal(10,2)
 supplierChildNet Decimal? @db.Decimal(10,2)
 supplierAdultCommission Decimal? @db.Decimal(10,2)
 supplierChildCommission Decimal? @db.Decimal(10,2)
 operator BusinessPartner? @relation(fields: [operatorId], references: [id], onDelete: Restrict)
 agentPrices AgentTourPrice[]
 @@index([operatorId])
 @@index([status])
 @@schema("app_private")
}

model AgentTourPrice {
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 agentId String @db.Uuid
 tourId String @db.Uuid
 adultPrice Decimal? @db.Decimal(10,2)
 childPrice Decimal? @db.Decimal(10,2)
 status String @db.VarChar(50)
 agent BusinessPartner @relation(fields: [agentId], references: [id], onDelete: Restrict)
 tour TourProgram @relation(fields: [tourId], references: [id], onDelete: Restrict)
 @@unique([agentId, tourId])
 @@index([tourId])
 @@index([status])
 @@schema("app_private")
}

model PickupLocation {
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 code String @db.VarChar(40) @unique
 name String @db.VarChar(200)
 status String @db.VarChar(50)
 kind String @db.VarChar(50)
 zone String? @db.VarChar(200)
 address String? @db.VarChar(1000)
 latitude String? @db.VarChar(30)
 longitude String? @db.VarChar(30)
 pickupNotes String? @db.VarChar(1000)
 @@index([status])
 @@schema("app_private")
 province String? @db.VarChar(100)
 district String? @db.VarChar(100)
 subdistrict String? @db.VarChar(100)
 houseNumber String? @db.VarChar(50)
 moo String? @db.VarChar(20)
 villageName String? @db.VarChar(150)
 mapUrl String? @db.VarChar(2048)
}

model FleetVehicle {
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 code String @db.VarChar(40) @unique
 name String @db.VarChar(200)
 status String @db.VarChar(50)
 kind String @db.VarChar(50)
 capacity Int
 ownership String @db.VarChar(50)
 providerId String? @db.Uuid
 registration String? @db.VarChar(100)
 notes String? @db.VarChar(1000)
 provider BusinessPartner? @relation(fields: [providerId], references: [id], onDelete: Restrict)
 @@index([providerId])
 @@index([status])
 @@schema("app_private")
}
