generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  schemas = ["app_private"]
}
enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  @@schema("app_private")
}
enum AccessScope {
  SELF
  COMPANY
  @@schema("app_private")
}
model UserProfile {
  id String @id @db.Uuid
  displayName String @db.VarChar(100)
  department String? @db.VarChar(30)
  address String? @db.VarChar(1000)
  primaryPhone String? @db.VarChar(32)
  emergencyPhone String? @db.VarChar(32)
  lineId String? @db.VarChar(100)
  status AccountStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  roles UserRole[]
  dispatchStaff DispatchStaff[]
  @@schema("app_private")
 province String? @db.VarChar(100)
 district String? @db.VarChar(100)
 subdistrict String? @db.VarChar(100)
 postalCode String? @db.VarChar(5)
 houseNumber String? @db.VarChar(50)
 moo String? @db.VarChar(20)
 villageName String? @db.VarChar(150)
 mapUrl String? @db.VarChar(2048)
 latitude String? @db.VarChar(30)
 longitude String? @db.VarChar(30)
}
model Role {
  code String @id @db.VarChar(50)
  name String @db.VarChar(100)
  users UserRole[]
  permissions RolePermission[]
  invitations InvitationRole[]
  @@schema("app_private")
}
model Permission {
  code String @id @db.VarChar(100)
  description String
  roles RolePermission[]
  @@schema("app_private")
}
model UserRole {
  userId String @db.Uuid
  roleCode String @db.VarChar(50)
  scope AccessScope @default(SELF)
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  @@id([userId, roleCode, scope])
  @@index([roleCode])
  @@schema("app_private")
}
model RolePermission {
  roleCode String @db.VarChar(50)
  permissionCode String @db.VarChar(100)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)
  @@id([roleCode, permissionCode])
  @@index([permissionCode])
  @@schema("app_private")
}
model Invitation {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  tokenHash String @unique @db.Char(64)
  displayName String @db.VarChar(100)
  department String? @db.VarChar(30)
  acceptedAt DateTime? @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdById String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  roles InvitationRole[]
  @@schema("app_private")
}
model InvitationRole {
  invitationId String @db.Uuid
  roleCode String @db.VarChar(50)
  scope AccessScope @default(SELF)
  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  @@id([invitationId, roleCode, scope])
  @@index([roleCode])
  @@schema("app_private")
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  action String @db.VarChar(100)
  targetId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  details Json
  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
  @@schema("app_private")
}

model SalesChannel {
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 code String @db.VarChar(40) @unique
 name String @db.VarChar(200)
 status String @db.VarChar(50)
 kind String @db.VarChar(50)
 @@index([status])
 @@schema("app_private")
}

model CompanySettings {
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 name String @db.VarChar(200)
 legalName String? @db.VarChar(200)
 taxId String? @db.VarChar(30)
 address String? @db.VarChar(1000)
 phone String? @db.VarChar(32)
 email String? @db.VarChar(254)
 @@schema("app_private")
 province String? @db.VarChar(100)
 district String? @db.VarChar(100)
 subdistrict String? @db.VarChar(100)
 postalCode String? @db.VarChar(5)
 houseNumber String? @db.VarChar(50)
 moo String? @db.VarChar(20)
 villageName String? @db.VarChar(150)
 mapUrl String? @db.VarChar(2048)
 latitude String? @db.VarChar(30)
 longitude String? @db.VarChar(30)
}

model BusinessPartner {
 allowedPaymentTerms String[] @default(["PREPAID", "PAID", "COUNTER", "AGENT_CREDIT"])
 defaultPaymentTerms String @default("COUNTER") @db.VarChar(30)
 agreements AgentAgreement[]
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 code String @db.VarChar(40) @unique
 name String @db.VarChar(200)
 status String @db.VarChar(50)
 roles String[]
 contactName String? @db.VarChar(200)
 phone String? @db.VarChar(32)
 email String? @db.VarChar(254)
 address String? @db.VarChar(1000)
 association String? @db.VarChar(200)
 paymentTerms String? @db.VarChar(1000)
 services OperationResource[]
 tours TourProgram[]
 agentPrices AgentTourPrice[]
 bookings TourBooking[]
 vehicles FleetVehicle[]
 @@index([status])
 @@schema("app_private")
 province String? @db.VarChar(100)
 district String? @db.VarChar(100)
 subdistrict String? @db.VarChar(100)
 postalCode String? @db.VarChar(5)
 houseNumber String? @db.VarChar(50)
 moo String? @db.VarChar(20)
 villageName String? @db.VarChar(150)
 mapUrl String? @db.VarChar(2048)
 latitude String? @db.VarChar(30)
 longitude String? @db.VarChar(30)
}

model TourProgram {
 journeyMode String @default("FIXED") @db.VarChar(30)
 durationDays Int? @default(1)
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 code String @db.VarChar(40) @unique
 name String @db.VarChar(200)
 status String @db.VarChar(50)
 ownership String @db.VarChar(50)
 operatorId String? @db.Uuid
 route String? @db.VarChar(2000)
 departureTimes String? @db.VarChar(300)
 childPolicy String? @db.VarChar(1000)
 confirmationMode String @db.VarChar(50)
 cancellationTerms String? @db.VarChar(2000)
 bookingCutoff String? @db.VarChar(300)
 adultPrice Decimal? @db.Decimal(10,2)
 childPrice Decimal? @db.Decimal(10,2)
 supplierPricing String @db.VarChar(50)
 supplierAdultNet Decimal? @db.Decimal(10,2)
 supplierChildNet Decimal? @db.Decimal(10,2)
 supplierAdultCommission Decimal? @db.Decimal(10,2)
 supplierChildCommission Decimal? @db.Decimal(10,2)
 operator BusinessPartner? @relation(fields: [operatorId], references: [id], onDelete: Restrict)
 components ProgramComponent[]
 trips OperationTrip[]
 agentPrices AgentTourPrice[]
 @@index([operatorId])
 @@index([status])
 @@schema("app_private")
}

model AgentTourPrice {
 agreementId String? @db.Uuid
 agreement AgentAgreement? @relation(fields:[agreementId],references:[id],onDelete:Restrict)
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 agentId String @db.Uuid
 tourId String @db.Uuid
 adultPrice Decimal? @db.Decimal(10,2)
 childPrice Decimal? @db.Decimal(10,2)
 status String @db.VarChar(50)
 agent BusinessPartner @relation(fields: [agentId], references: [id], onDelete: Restrict)
 tour TourProgram @relation(fields: [tourId], references: [id], onDelete: Restrict)
 @@unique([agentId, tourId, agreementId])
 @@index([tourId])
 @@index([status])
 @@schema("app_private")
}

model PickupLocation {
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 code String @db.VarChar(40) @unique
 name String @db.VarChar(200)
 status String @db.VarChar(50)
 kind String @db.VarChar(50)
 zone String? @db.VarChar(200)
 address String? @db.VarChar(1000)
 latitude String? @db.VarChar(30)
 longitude String? @db.VarChar(30)
 pickupNotes String? @db.VarChar(1000)
 @@index([status])
 @@schema("app_private")
 province String? @db.VarChar(100)
 district String? @db.VarChar(100)
 subdistrict String? @db.VarChar(100)
 postalCode String? @db.VarChar(5)
 houseNumber String? @db.VarChar(50)
 moo String? @db.VarChar(20)
 villageName String? @db.VarChar(150)
 mapUrl String? @db.VarChar(2048)
}

model FleetVehicle {
 id String @id @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 code String @db.VarChar(40) @unique
 name String @db.VarChar(200)
 status String @db.VarChar(50)
 kind String @db.VarChar(50)
 capacity Int
 engineCount Int?
 totalCapacity Int?
 expectedCrew Int?
 purposes String[] @default([])
 hireCost Decimal? @db.Decimal(10,2)
 commissionType String? @db.VarChar(30)
 commissionValue Decimal? @db.Decimal(10,2)
 ownership String @db.VarChar(50)
 providerId String? @db.Uuid
 registration String? @db.VarChar(100)
 notes String? @db.VarChar(1000)
 slots ServiceSlot[]
 provider BusinessPartner? @relation(fields: [providerId], references: [id], onDelete: Restrict)
 @@index([providerId])
 @@index([status])
 @@schema("app_private")
}

// Shared catalog identity; kind-specific validation belongs to operations/contracts.
model OperationResource {
 id String @id @db.Uuid
 version Int @default(1)
 code String @unique @db.VarChar(40)
 name String @db.VarChar(200)
 status String @db.VarChar(50)
 kind String @db.VarChar(30)
 category String @db.VarChar(50)
 baseUnit String @db.VarChar(30)
 ownership String? @db.VarChar(30)
 mealPeriod String? @db.VarChar(30)
 accommodationType String? @db.VarChar(30)
 occupancy Int?
 serviceMode String? @db.VarChar(30)
 verificationStatus String @default("UNVERIFIED") @db.VarChar(30)
 packSize Int?
 caseSize Int?
 size String? @db.VarChar(100)
 providerId String? @db.Uuid
 origin String? @db.VarChar(200)
 destination String? @db.VarChar(200)
 salePrice Decimal? @db.Decimal(10,2)
 costPrice Decimal? @db.Decimal(10,2)
 notes String? @db.VarChar(2000)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 provider BusinessPartner? @relation(fields: [providerId], references: [id], onDelete: Restrict)
 components ProgramComponent[]
 slots ServiceSlot[]
 lots StockLot[]
 bookingLines BookingComponent[]
 @@index([kind,status])
 @@schema("app_private")
}
model StockLocation {
 id String @id @db.Uuid
 version Int @default(1)
 code String @unique @db.VarChar(40)
 name String @db.VarChar(200)
 kind String @db.VarChar(30)
 status String @db.VarChar(50)
 notes String? @db.VarChar(2000)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 balances StockBalance[]
 issuedFrom StockIssue[] @relation("IssueSource")
 issuedTo StockIssue[] @relation("IssueDestination")
 sources BookingComponent[]
 @@schema("app_private")
}
model ProgramComponent {
 removalCredit Decimal? @db.Decimal(10,2)
 id String @id @db.Uuid
 version Int @default(1)
 tourId String @db.Uuid
 resourceId String @db.Uuid
 selection String @db.VarChar(30)
 basis String @db.VarChar(30)
 quantity Int
 usagePoint String @db.VarChar(30)
 day Int @default(1)
 notes String? @db.VarChar(1000)
 status String @db.VarChar(50)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 tour TourProgram @relation(fields:[tourId], references:[id], onDelete:Restrict)
 resource OperationResource @relation(fields:[resourceId], references:[id], onDelete:Restrict)
 @@index([tourId,status])
 @@schema("app_private")
}
model ServiceSlot {
 run DispatchRun?
 id String @id @db.Uuid
 version Int @default(1)
 code String @unique @db.VarChar(40)
 name String @db.VarChar(200)
 resourceId String @db.Uuid
 vehicleId String? @db.Uuid
 startsAt DateTime @db.Timestamptz(6)
 endsAt DateTime @db.Timestamptz(6)
 capacity Int
 status String @db.VarChar(50)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 resource OperationResource @relation(fields:[resourceId],references:[id],onDelete:Restrict)
 vehicle FleetVehicle? @relation(fields:[vehicleId],references:[id],onDelete:Restrict)
 bookingLines BookingComponent[]
 @@index([resourceId,startsAt,endsAt])
 @@index([vehicleId,startsAt,endsAt])
 @@schema("app_private")
}
model OperationTrip {
 id String @id @db.Uuid
 version Int @default(1)
 code String @unique @db.VarChar(40)
 name String @db.VarChar(200)
 tourId String? @db.Uuid
 startsAt DateTime @db.Timestamptz(6)
 endsAt DateTime @db.Timestamptz(6)
 capacity Int
 status String @default("OPEN") @db.VarChar(30)
 notes String? @db.VarChar(2000)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 tour TourProgram? @relation(fields:[tourId],references:[id],onDelete:Restrict)
 bookings TourBooking[]
 @@index([startsAt,endsAt])
 @@schema("app_private")
}
model TourBooking {
 outboundDate DateTime? @db.Date
 returnDate DateTime? @db.Date
 returnStatus String @default("OUR") @db.VarChar(20)
 createdById String? @db.Uuid
 hotelId String? @db.Uuid
 channelId String? @db.Uuid
 allergyStatus String @default("UNKNOWN") @db.VarChar(20)
 specialRequirements String[] @default([])
 @@index([outboundDate,status])
 @@index([returnDate,status])
 agentId String? @db.Uuid
 agentName String? @db.VarChar(200)
 agentPhone String? @db.VarChar(32)
 agentReference String? @db.VarChar(100)
 contactPhone String? @db.VarChar(32)
 hotel String? @db.VarChar(200)
 room String? @db.VarChar(100)
 pickupPoint String? @db.VarChar(200)
 dropoffPoint String? @db.VarChar(200)
 allergies String? @db.VarChar(2000)
 assistance String? @db.VarChar(2000)
 requestNotes String? @db.VarChar(2000)
 paymentTerms String @default("UNSET") @db.VarChar(30)
 afterServiceReason String? @db.VarChar(1000)
 agent BusinessPartner? @relation(fields:[agentId],references:[id],onDelete:Restrict)
 @@index([agentId])
 id String @id @db.Uuid
 version Int @default(1)
 code String @unique @db.VarChar(40)
 name String @db.VarChar(200)
 tripId String @db.Uuid
 adults Int
 children Int
 status String @default("DRAFT") @db.VarChar(30)
 adultPrice Decimal? @db.Decimal(10,2)
 childPrice Decimal? @db.Decimal(10,2)
 programSnapshot Json
 requestHash String @db.Char(64)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 trip OperationTrip @relation(fields:[tripId],references:[id],onDelete:Restrict)
 lines BookingComponent[]
 @@index([tripId,status])
 @@schema("app_private")
}
model BookingComponent {
 dispatchDirection String @default("BOTH") @db.VarChar(20)
 dispatchAssignments DispatchAssignment[]
 id String @id @db.Uuid
 bookingId String @db.Uuid
 resourceId String @db.Uuid
 slotId String? @db.Uuid
 sourceId String? @db.Uuid
 quantity Int
 issuedQty Int @default(0)
 selected Boolean
 included Boolean
 usagePoint String @db.VarChar(30)
 snapshot Json
 unitPrice Decimal? @db.Decimal(10,2)
 booking TourBooking @relation(fields:[bookingId],references:[id],onDelete:Restrict)
 resource OperationResource @relation(fields:[resourceId],references:[id],onDelete:Restrict)
 slot ServiceSlot? @relation(fields:[slotId],references:[id],onDelete:Restrict)
 source StockLocation? @relation(fields:[sourceId],references:[id],onDelete:Restrict)
 issues StockIssue[]
 @@index([resourceId,sourceId])
 @@index([slotId])
 @@index([bookingId])
 @@schema("app_private")
}
model StockLot {
 id String @id @db.Uuid
 resourceId String @db.Uuid
 label String @db.VarChar(200)
 receivedOn DateTime @db.Date
 expiresOn DateTime? @db.Date
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 resource OperationResource @relation(fields:[resourceId],references:[id],onDelete:Restrict)
