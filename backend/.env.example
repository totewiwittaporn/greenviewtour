# Copy to backend/.env. Keep the password out of Git and chat.
APP_ENV=preview
SUPABASE_PROJECT_REF=qplzgpyidszxbtbyknjc
SUPABASE_URL=https://qplzgpyidszxbtbyknjc.supabase.co
# Direct connection requires IPv6. For IPv4 use Connect > Session pooler:
# copy its exact host and set PGUSER=postgres.qplzgpyidszxbtbyknjc.
PGHOST=db.qplzgpyidszxbtbyknjc.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=REPLACE_ME
# Optional: path to the downloaded Supabase root CA when required by the endpoint.
# PGSSLROOTCERT=/absolute/path/to/prod-supabase.cer

# Public API key for Supabase Auth (never a service-role key)
SUPABASE_PUBLISHABLE_KEY=
