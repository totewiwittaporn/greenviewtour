{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "greenviewtour-api-local",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "greenviewtour-local",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "prisma-d1/migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "greenviewtour-local-files",
      "remote": false
    }
  ],
  "vars": {
    "APP_ENV": "local",
    "D1_LOCATION_HINT": "apac"
  },
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  }
}
