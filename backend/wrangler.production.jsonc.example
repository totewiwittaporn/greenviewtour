{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "greenviewtour-api",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "greenviewtour-production",
      "database_id": "SET_ONLY_AFTER_PRODUCTION_RELEASE_APPROVAL",
      "migrations_dir": "prisma-d1/migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "greenviewtour-production-files",
      "remote": false
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "D1_LOCATION_HINT": "apac"
  },
  "workers_dev": false,
  "preview_urls": false
}
