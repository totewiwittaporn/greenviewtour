{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "greenviewtour-api",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 16 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "greenviewtour-production",
      "database_id": "SET_ONLY_AFTER_PRODUCTION_RELEASE_APPROVAL",
      "migrations_dir": "prisma-d1/migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "greenviewtour-production-files",
      "remote": false
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "D1_LOCATION_HINT": "apac",
    "AUTH_EMAIL_FROM": "system@greenviewtour.com",
    "PRODUCTION_ENABLED": "false",
    "DAILY_WORK_ASSIGNMENT_AUTO_SEND": "false",
    "DAILY_WORK_ASSIGNMENT_ACTOR_ID": "SET_AFTER_PRODUCTION_APPROVAL",
    "BACKOFFICE_ORIGIN": "https://backoffice.greenviewtour.com",
    "PUBLIC_ORIGIN": "https://greenviewtour.com",
    "MEMBER_ORIGIN": "https://member.greenviewtour.com",
    "LINE_STAFF_ENABLED": "false"
  },
  "workers_dev": false,
  "preview_urls": false,
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "system@greenviewtour.com"
      ],
      "remote": false
    }
  ],
  "assets": {
    "directory": "../frontend/backoffice/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/health",
      "/health/*"
    ]
  },
  "placement": {
    "region": "aws:ap-northeast-1"
  }
}
