{
  "name": "@greenviewtour/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-d1": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/driver-adapter-utils": "7.10.0",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.6"
  },
  "scripts": {
    "db:check": "node ../scripts/local-health.js",
    "test": "node --test test/*.test.js",
    "dev": "node ../scripts/dev.js --worker-only",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "db:migrate": "node ../scripts/local-cloudflare.js migrate",
    "owner:invite": "node ../scripts/retired-source-command.js",
    "db:identity-check": "node ../scripts/retired-source-command.js",
    "d1:schema": "node scripts/generate-d1-schema.js",
    "d1:generate": "node ../scripts/local-cloudflare.js generate"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
