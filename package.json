{
  "name": "greenviewtour",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:public": "npm run dev --workspace @greenviewtour/public-web",
    "dev:backoffice": "npm run dev --workspace @greenviewtour/backoffice",
    "build": "npm run build:public && npm run build:backoffice && npm run build:member",
    "build:public": "npm run build --workspace @greenviewtour/public-web",
    "build:backoffice": "npm run build --workspace @greenviewtour/backoffice",
    "lint": "eslint .",
    "check": "npm run local:workflow:check && npm run lint && npm run test:backend && npm run test:frontend && npm run build && npm run cloudflare:check",
    "check:quiet": "node scripts/check-quiet.mjs",
    "db:check": "node scripts/local-health.js",
    "test:backend": "npm run test --workspace @greenviewtour/api",
    "postinstall": "npm run prisma:generate --workspace @greenviewtour/api && npm run cloudflare:d1:generate",
    "db:migrate": "node scripts/local-cloudflare.js migrate",
    "owner:invite": "node scripts/retired-source-command.js",
    "test:frontend": "node --test frontend/backoffice/test/*.test.js frontend/member/test/*.test.js frontend/public-web/test/*.test.js",
    "build:member": "npm run build --workspace @greenviewtour/member",
    "cloudflare:d1:schema": "node backend/scripts/generate-d1-schema.js",
    "cloudflare:d1:generate": "node scripts/local-cloudflare.js generate",
    "cloudflare:d1:migrate:local": "node scripts/local-cloudflare.js migrate",
    "cloudflare:types": "node scripts/local-cloudflare.js types",
    "cloudflare:dev": "npm run local:dev",
    "cloudflare:check": "node scripts/local-cloudflare.js bundle",
    "local:setup": "node scripts/local-cloudflare.js setup",
    "local:dev": "node scripts/dev.js",
    "local:db:migrate": "node scripts/local-cloudflare.js migrate",
    "local:check": "npm run local:setup && node scripts/local-cloudflare.js test",
    "backup:source": "node scripts/retired-source-command.js",
    "local:data:plan": "node scripts/local-data.js plan",
    "local:data:import": "node scripts/local-data.js apply",
    "local:data:verify": "node scripts/local-data.js verify",
    "local:check:business": "node scripts/test-d1-business.mjs core capacity operations dispatch reports finance identity member catalog attendance demo",
    "local:identity:plan": "node scripts/local-identity.js plan",
    "local:identity:import": "node scripts/local-identity.js apply",
    "local:identity:verify": "node scripts/local-identity.js verify",
    "local:worker": "node scripts/dev.js --worker-only",
    "local:auth:plan": "node scripts/local-auth-import.js plan",
    "local:auth:import": "node scripts/local-auth-import.js apply",
    "local:auth:verify": "node scripts/local-auth-import.js verify",
    "local:auth:check": "node scripts/test-auth-api.mjs",
    "local:mail": "node scripts/local-mail.js",
    "serve:build:public": "npm run serve:build --workspace @greenviewtour/public-web",
    "serve:build:backoffice": "npm run serve:build --workspace @greenviewtour/backoffice",
    "serve:build:member": "npm run serve:build --workspace @greenviewtour/member",
    "local:backup": "node scripts/local-backup.js create",
    "local:backup:verify": "node scripts/local-backup.js verify",
    "local:workflow:check": "node scripts/audit-local-workflow.js",
    "local:check:browser": "node scripts/test-local-browser.mjs",
    "local:line:check": "node scripts/test-staff-line.mjs",
    "local:line:browser": "node scripts/test-staff-line-browser.mjs",
    "local:staff-digest:plan": "node scripts/plan-staff-digest.js",
    "local:staff-digest:check": "node scripts/test-staff-digests.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "playwright": "1.63.0",
    "vite": "^7.1.7",
    "wrangler": "^4.143.0"
  },
  "workspaces": [
    "frontend/*",
    "backend",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  }
}
