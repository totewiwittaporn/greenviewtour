{
  "name": "greenviewtour",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:public": "npm run dev --workspace @greenviewtour/public-web",
    "dev:backoffice": "npm run dev --workspace @greenviewtour/backoffice",
    "build": "npm run build:public && npm run build:backoffice && npm run build:member",
    "build:public": "npm run build --workspace @greenviewtour/public-web",
    "build:backoffice": "npm run build --workspace @greenviewtour/backoffice",
    "preview": "npm run preview --workspace @greenviewtour/public-web",
    "preview:backoffice": "npm run preview --workspace @greenviewtour/backoffice",
    "lint": "eslint .",
    "check": "npm run lint && npm run test:backend && npm run test:frontend && npm run build && npm run cloudflare:check",
    "check:quiet": "node scripts/check-quiet.mjs",
    "db:check": "npm run db:check --workspace @greenviewtour/api",
    "test:backend": "npm run test --workspace @greenviewtour/api",
    "postinstall": "npm run prisma:generate --workspace @greenviewtour/api",
    "db:migrate": "npm run db:migrate --workspace @greenviewtour/api",
    "owner:invite": "npm run owner:invite --workspace @greenviewtour/api --",
    "test:frontend": "node --test frontend/backoffice/test/*.test.js frontend/member/test/*.test.js frontend/public-web/test/*.test.js",
    "build:member": "npm run build --workspace @greenviewtour/member",
    "cloudflare:d1:schema": "node backend/scripts/generate-d1-schema.js",
    "cloudflare:d1:generate": "node scripts/local-cloudflare.js generate",
    "cloudflare:d1:migrate:local": "node scripts/local-cloudflare.js migrate",
    "cloudflare:types": "node scripts/local-cloudflare.js types",
    "cloudflare:dev": "npm run local:dev",
    "cloudflare:check": "node scripts/local-cloudflare.js bundle",
    "local:setup": "node scripts/local-cloudflare.js setup",
    "local:dev": "npm run local:setup && node scripts/local-cloudflare.js dev",
    "local:db:migrate": "node scripts/local-cloudflare.js migrate",
    "local:check": "npm run local:setup && node scripts/local-cloudflare.js test",
    "backup:source": "node scripts/backup-source.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "playwright": "1.63.0",
    "vite": "^7.1.7",
    "wrangler": "^4.143.0"
  },
  "workspaces": [
    "frontend/*",
    "backend",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  }
}
